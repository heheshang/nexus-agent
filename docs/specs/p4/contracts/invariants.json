      "status": "verified"
    },
    {
      "id": "P4-I25",
      "statement": "工具输出超长被截断 —— 一个返回巨量输出的工具不会撑爆上下文预算",
      "layer": "behavior",
      "verified_by": [
        "crates/nexus-agent/src/tools.rs::an_oversized_tool_output_is_truncated"
      ],
      "status": "planned"
    }
  ],
  "pipeline_order": [
    "protocol_pairing_validation",
    "context_compaction",
    "model_call",
    "output_validation",
    "tool_execution",
    "tool_result_replay"
  ],
  "decisions": [
    {
      "id": "D4",
      "decision": "nexus-agent 自定义 ChatModel trait，方法签名复用 nexus-llm 的数据类型；Gateway 经 trait 注入，不引用具体类型",
      "basis": "docs/specs/p4/spec.md §6.1 —— 参考架构 §2.2 的禁令对象是具体 Gateway 实现类型；check-deps.sh 已允许 agent → llm；零类型重复；不动已交付的 P3 代码",
      "category": "decide-and-proceed"
    },
    {
      "id": "D5",
      "decision": "上下文裁剪用整轮淘汰，不生成摘要",
      "basis": "docs/specs/p4/spec.md §6.2 —— 可验证性（摘要的正确性不可断言）/ 避免事实漂移 / 不放大 prompt injection 面",
      "category": "decide-and-proceed"
    },
    {
      "id": "D6",
      "decision": "迭代上限 / 超时 / 工具并发上限由调用方传入，nexus-agent 不内置默认值",
      "basis": "docs/specs/p4/spec.md §6.4 —— 缺省值会让「没配」与「配成 0」无法区分",
      "category": "decide-and-proceed"
    },
    {
      "id": "D7",
      "decision": "P4 自定义异步事件 sink，不复用 nexus-core::EventSink",
      "basis": "docs/specs/p4/spec.md §6.5 —— nexus-core 的是同步单写者，P4 需要并发生产者 + 背压 + 单点分配序号",
      "category": "decide-and-proceed"
    }
  ],
  "excluded": [
    {
      "item": "协议类型下沉到 nexus-model",
      "reason": "决策 D4 的后续任务 F1 —— 触发条件是 P8（nexus-tool 需要同一套类型）"
    },
    {
      "item": "SSE 桥接 / 半帧处理",
      "reason": "属 P5（nexus-api）"
    },
    {
      "item": "危险工具的授权边界",
      "reason": "属 P8（nexus-tool / nexus-mcp）"
    },
    {
      "item": "Schema 子集白名单校验",
      "reason": "属 P8；P4 只把 parameters 原样透传给模型"
    },
    {
      "item": "Checkpoint / 中断恢复",
      "reason": "属 P6（nexus-workflow + nexus-execution）"
    },
    {
      "item": "长期记忆召回 / RAG 组装",
      "reason": "属 P7；P4 的输入历史由调用方组装好传入"
    },
    {
      "item": "FinishReason 增加 Canceled 变体",
      "reason": "决策：事件契约已定稿（§6.3），P4 用 done + Stop 表达取消；缺口登记为后续任务 F2"
    },
    {
      "item": "真实上游连通性",
      "reason": "P4 不依赖真实模型服务；用本地 mock 测"
    }
  ]
}
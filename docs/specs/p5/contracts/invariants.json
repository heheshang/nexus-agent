  "decisions": [
    {
      "id": "D8",
      "decision": "SSE 输出手写 Body::from_stream，不用 axum 的 Sse 类型",
      "basis": "docs/specs/p5/spec.md §6.1 —— 参考架构 §1.5 已定稿：axum 的 Sse 会自动转义 data，与前端 lib/sse.ts 的字节解析不一致",
      "category": "decide-and-proceed"
    },
    {
      "id": "D9",
      "decision": "P5 的交付边界是传输层能力（trait 接缝），不做业务编排",
      "basis": "docs/specs/p5/spec.md §6.2 —— nexus-service 是 7 行空壳；架构文档 §1.4 规定协议层不能感知业务规则；参考架构 §0.3 的 crate 职责表",
      "category": "decide-and-proceed"
    },
    {
      "id": "D10",
      "decision": "鉴权的机制在 P5，策略在上层（IdentityExtractor trait 接缝）",
      "basis": "docs/specs/p5/spec.md §6.3 —— nexus-security 是 7 行空壳；参考架构 §0.4 的 Go 版反例明确「权限由 service 注入」；与 P4 的 D4 同一条纪律",
      "category": "decide-and-proceed"
    },
    {
      "id": "D11",
      "decision": "统一响应包的成功 code 是数字 0",
      "basis": "docs/specs/p5/spec.md §6.4 —— 参考实现 internal/pkg/response 已定稿且前端已按 code==0 判成功；架构文档 §2.6.3 的验证记录要求 code 是数字以便前端按码段分支",
      "category": "decide-and-proceed"
    }
  ],
  "excluded": [
    {
      "item": "业务编排（会话保障 / 归属校验 / 上下文组装）",
      "reason": "决策 D9 —— 属 nexus-service；架构文档 §1.4 规定协议层不能感知业务规则"
    },
    {
      "item": "具体业务端点（KB / 工作流 / 记忆 / 模型管理）",
      "reason": "属 P6/P7/P8；P5 只交付注册机制"
    },
    {
      "item": "鉴权的具体策略（JWT 校验 / 配额判定）",
      "reason": "决策 D10 —— nexus-security 是 7 行空壳，JWT 形态未定；P5 交付机制"
    },
    {
      "item": "A2A 入站端点",
      "reason": "属 P8（nexus-a2a）；架构文档 §4.3.1 已定稿 A2A 双向"
    },
    {
      "item": "MCP 端点",
      "reason": "属 P8（nexus-mcp）"
    },
    {
      "item": "WebSocket / 长轮询",
      "reason": "架构文档 §1.2 的 nexus serve 只有 REST + SSE + A2A"
    },
    {
      "item": "FinishReason 增加 Canceled 变体",
      "reason": "事件契约已定稿（§6.3）；P5 只登记为 F3（承接 P4 的 F2），不在实现里顺手决定"
    },
    {
      "item": "优雅关停",
      "reason": "属 nexus-cli（进程生命周期）"
    }
  ]

# 本地覆盖配置示例。
#
# ⚠️  本文件**不入库**（`.gitignore` 已排除 `configs/local.yaml`）。
#     把它当作模板复制到 `configs/local.yaml` 后按需修改。
#
# 用法：
#     cp configs/local.yaml.example configs/local.yaml
#
# 加载顺序：`config.yaml` → `local.yaml` → `secrets.yaml`（后者覆盖前者）。
# `secrets.yaml` 同样不入库。

log:
  level: debug

server:
  port: 9090

# database:
#   url: postgres://nexus:nexus@localhost:5432/nexus
#   max_connections: 20
